# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (for production, use your Vercel backend URL)
# Example: https://your-backend.vercel.app/api/v1
VITE_API_BASE_URL=

# Supabase (if using Supabase Auth directly from frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=