{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "none",
  "installCommand": "npm install",
  "devCommand": "npm run start:dev",
  "regions": ["iad1"],
  "functions": {
    "src/main.vercel.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/main.vercel.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/src/main.vercel.ts"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS,PATCH"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, X-Business-Id"
        }
      ]
    }
  ]
}