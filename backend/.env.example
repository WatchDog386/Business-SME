# Application
NODE_ENV=development
PORT=4000

# Database
# Driver: "postgres" for production, "sqljs" for zero-setup local dev (WASM)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kenya_sme
DB_SYNCHRONIZE=true

# Postgres connection string (used when DB_DRIVER=postgres and DB_URL is set)
# For Supabase, use the Session pooler (port 5432, IPv4):
#   postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase API keys (optional; for Supabase Auth/Data API, not the DB connection)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Assistant (Gemini)
GEMINI_API_KEY=AQ.Ab8RN6IszIjyCcBpGpouSahHv3uQSCnwV5DMMaIIkjhAT1z_-w
GEMINI_MODEL=gemini-1.5-pro
AI_SYSTEM_API_BASE=http://localhost:4000
AI_BUSINESS_ID=